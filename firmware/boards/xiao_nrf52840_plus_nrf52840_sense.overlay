/*
 * Seeed XIAO nRF52840 Sense Plus pin assignments (Zephyr 4.6+ board target
 * xiao_nrf52840_plus/nrf52840/sense). Same pins as the regular Sense; on
 * Zephyr 4.5 just build for xiao_ble/nrf52840/sense, which runs on the Plus too.
 *
 *   D0 (P0.02)  audio left   -> RC filter -> headphone jack tip
 *   D1 (P0.03)  audio right  -> RC filter -> headphone jack ring
 *   D2 (P0.28)  ZERO button  -> GND
 *   D3 (P0.29)  MODE button  -> GND (also wakes from power-off)
 *   D6 (P1.11)  UART TX      -> Pi GPIO15 / RXD (header pin 10)
 *   D7 (P1.12)  UART RX      <- Pi GPIO14 / TXD (header pin 8)
 *
 * The IMU is the on-board LSM6DS3TR-C.
 */
#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	aliases {
		imu0 = &lsm6ds3tr_c;
	};

	zephyr,user {
		audio-gpios = <&gpio0 2 0>, <&gpio0 3 0>;
		button-gpios = <&gpio0 28 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>,
			       <&gpio0 29 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
		link-uart = <&uart0>;
	};
};

/* PWM1 is driven directly through nrfx for audio; keep Zephyr's driver off it. */
&pwm1 {
	status = "disabled";
};
